#loc1 = loc("x_ptr")
#loc2 = loc("y_ptr")
#loc3 = loc("output_ptr")
#loc4 = loc("n_elements")
module {
  tt.func public @add_kernel(%x_ptr: !tt.ptr<f32> {tt.divisibility = 16 : i32} loc("x_ptr"), %y_ptr: !tt.ptr<f32> {tt.divisibility = 16 : i32} loc("y_ptr"), %output_ptr: !tt.ptr<f32> {tt.divisibility = 16 : i32} loc("output_ptr"), %n_elements: i32 loc("n_elements")) attributes {noinline = false} {
    %c0 = arith.constant 0 : index loc(#loc)
    %cst = arith.constant dense<0.000000e+00> : vector<256xf32> loc(#loc)
    %cst_0 = arith.constant dense<""> : vector<256xi32> loc(#loc)
    %c256_i32 = arith.constant 256 : i32 loc(#loc)
    %0 = tt.get_program_id x : i32 loc(#loc)
    %1 = arith.muli %0, %c256_i32 : i32 loc(#loc)
    %2 = vector.broadcast %1 : i32 to vector<256xi32> loc(#loc)
    %3 = arith.subi %2, %cst_0 : vector<256xi32> loc(#loc)
    %4 = vector.broadcast %n_elements : i32 to vector<256xi32> loc(#loc)
    %5 = arith.cmpi slt, %3, %4 : vector<256xi32> loc(#loc)
    %6 = triton_cpu.ptr_to_memref %x_ptr : <f32> -> memref<f32> loc(#loc)
    %7 = vector.gather %6[] [%3], %5, %cst : memref<f32>, vector<256xi32>, vector<256xi1>, vector<256xf32> into vector<256xf32> loc(#loc)
    %8 = triton_cpu.ptr_to_memref %y_ptr : <f32> -> memref<f32> loc(#loc)
    %9 = vector.gather %8[] [%3], %5, %cst : memref<f32>, vector<256xi32>, vector<256xi1>, vector<256xf32> into vector<256xf32> loc(#loc)
    %10 = arith.addf %7, %9 : vector<256xf32> loc(#loc)
    %11 = triton_cpu.ptr_to_memref %output_ptr : <f32> -> memref<256xf32> loc(#loc)
    vector.scatter %11[%c0] [%3], %5, %10 : memref<256xf32>, vector<256xi32>, vector<256xi1>, vector<256xf32> loc(#loc)
    tt.return loc(#loc)
  } loc(#loc)
} loc(#loc)
#loc = loc(unknown)
